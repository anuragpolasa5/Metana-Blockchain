pragma solidity ^0.8.0;

import "./token.sol";

/// @title TestToken - Echidna Exercise 1: Testing Token Balance
/// @author Trail of Bits (Echidna Exercise)
/// @notice This contract tests that echidna_caller cannot have more than 10000 tokens.
/// @dev EX1-03: Defines the Echidna property to verify the balance invariant holds
///      after any arbitrary sequence of transactions generated by the fuzzer.
contract TestToken is Token {
    /// @notice The address used by Echidna as the default caller
    address echidna_caller = msg.sender;

    /// @notice Initializes the test with 10000 tokens for the caller
    /// @dev EX1-03: Sets up initial state for property testing
    constructor() {
        balances[echidna_caller] = 10000;
    }

    /// @notice Echidna property: the caller's balance should never exceed 10000
    /// @dev EX1-03: This property will PASS after the fix (require in transfer).
    ///      Before the fix, Echidna would find that transferring to oneself or
    ///      transferring more than owned could violate this invariant.
    /// @return true if the invariant holds, false if violated
    function echidna_test_balance() public view returns (bool) {
        return balances[echidna_caller] <= 10000;
    }
}
