# Sepolia RPC endpoint (SEPOLIA_RPC_URL takes precedence; RPC_URL also accepted)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key (funded with Sepolia ETH) — never commit the real value
PRIVATE_KEY=your_private_key_here

# Optional deployment configuration. If MINT_THRESHOLD_USD is omitted, deploy.js
# derives it as 110% of the live XAU/USD price. Explicit thresholds must be above
# the live price or deployment aborts before broadcasting.
# MINT_THRESHOLD_USD=5000
UPDATE_INTERVAL=300

# Ethereum Sepolia defaults are 2x each documented feed heartbeat:
# XAU/USD: 24h heartbeat -> 172800s; ETH/USD: 1h heartbeat -> 7200s.
XAU_MAX_STALENESS=172800
ETH_USD_MAX_STALENESS=7200

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
